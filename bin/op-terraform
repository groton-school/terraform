#!/bin/sh

source "$PWD/.env"
OP_TOKEN=$(op item get --account="$OP_ACCOUNT" --field=credential --reveal $OP_ITEM)

COMMAND=""
case $1 in
    init)
        COMMAND="init -upgrade"
        ;;
    apply)
        COMMAND="apply -input=false -auto-approve"
        ;;
    *)
        exit
        ;;
esac

op run \
    --env-file=.env \
    --account="$OP_ACCOUNT" \
    --no-masking \
    -- \
        terraform -chdir=./infra $COMMAND