{
  "scripts": {
    "build": "turbo build",
    "deploy": "run-s deploy:*",
    "deploy:build": "run-s build",
    "deploy:clean": "del ./out",
    "deploy:prepare-prune": "swap-gitignore prune",
    "deploy:prune": "turbo prune app --out-dir ./out/app",
    "deploy:gcloudignore": "cp ./.gcloudignore ./out/app/",
    "deploy:cleanup-prune": "swap-gitignore commit",
    "deploy:require-gcloud-auth": "require-gcloud-auth",
    "deploy:terraform": "op-terraform apply",
    "gcp-build": "turbo build",
    "start": "turbo start --env-mode=loose",
    "release": "turbo --concurrency 1 release"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
