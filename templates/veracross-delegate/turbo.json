{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "dist",
        "build"
      ]
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "release": {
      "dependsOn": ["^release"],
      "outputs": ["package.json", "CHANGELOG.md"]
    }
  }
}
